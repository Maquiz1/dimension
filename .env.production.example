# Server settings for DIMENSION (Docker). On the server: cp .env.production.example .env, then fill in.
# Never commit the real .env. Generate secrets with:  openssl rand -base64 48

# Makes plain `docker compose` use the production file on the server.
COMPOSE_FILE=docker-compose.prod.yml

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=dimension.tamris.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://dimension.tamris.org
# Keep 1. Set 0 only for a first test over plain HTTP (logins still need HTTPS: cookies are secure).
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL (the dimension-db container; also used by docker-compose.prod.yml) ---
POSTGRES_DB=dimension
POSTGRES_USER=dimension
POSTGRES_PASSWORD=change-me

# --- Docker ---
# Port on 127.0.0.1 that the host nginx forwards dimension.tamris.org to (must be free on the server).
WEB_PORT=8091

# --- ODK Central, used by pull_odk. Fill in after the Central project and its pull account exist. ---
ODK_URL=https://odk.tamris.org
ODK_EMAIL=
ODK_PASSWORD=
ODK_PROJECT_ID=
ODK_VERIFY_TLS=1
